# Copy this file to ".env" and fill in what you need.
# The app works fully with NONE of these set (rule-based insights kick in).

# --- Database ---
DATABASE_URL=sqlite:///./finance.db

# --- Auth ---
# Secret used to sign JWTs. MUST be set to a strong random value in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
JWT_SECRET=dev-insecure-change-me

# --- AI: Ollama (free, local, PRIMARY) ---
# Install from https://ollama.com then run:  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- AI: Gemini (free tier, optional) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# --- AI: OpenAI (paid, optional) ---
OPENAI_API_KEY=

# --- CORS: where the React dev server runs ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Signup abuse prevention (optional) ---
# Cloudflare Turnstile SECRET key (server-side). Blank -> CAPTCHA disabled.
# Create a free widget at https://dash.cloudflare.com -> Turnstile, and put its
# public site key in the frontend's VITE_TURNSTILE_SITE_KEY. Set both or neither.
# Cloudflare test keys (always-pass secret): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# --- Bank sync: Plaid (optional; sandbox) ---
# Get sandbox keys at https://dashboard.plaid.com (free). Blank -> feature hidden.
# Sandbox login is user_good / pass_good; never real bank credentials.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Fernet key that encrypts Plaid access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank -> dev/test only (ephemeral key). PRODUCTION MUST set a stable value.
PLAID_ENCRYPTION_KEY=
