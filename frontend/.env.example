# Copy to ".env" (or ".env.local") and fill in what you need.
# The app works fully with none of these set.

# --- Signup abuse prevention (optional) ---
# Cloudflare Turnstile PUBLIC site key. Blank -> the CAPTCHA widget is hidden and
# registration behaves normally. Pair it with the backend's TURNSTILE_SECRET.
# Cloudflare test key (always passes, visible): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
